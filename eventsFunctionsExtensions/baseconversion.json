      "fullName": "Convert to decimal",
      "functionType": "Expression",
      "name": "ToDecimal",
      "sentence": "",
      "events": [
        {
          "type": "BuiltinCommonInstructions::JsCode",
          "inlineCode": [
            "const convString = eventsFunctionContext.getArgument(\"String\");",
            "const convBase = eventsFunctionContext.getArgument(\"Base\");",
            "eventsFunctionContext.returnValue = parseInt(convString, convBase);",
            ""
